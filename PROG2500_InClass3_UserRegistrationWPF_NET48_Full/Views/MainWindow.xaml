<Window x:Class="UserRegistrationWPF.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cc="clr-namespace:UserRegistrationWPF.CustomControls"
        Title="Registration" Height="480" Width="640" WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="User Registration" FontSize="22" FontWeight="Bold" Margin="0,0,0,16"/>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <cc:ThemedLabel Grid.Row="0" Grid.Column="0" Content="Full Name"/>
            <cc:ThemedTextBox Grid.Row="0" Grid.Column="1" x:Name="txtFullName"/>
            <cc:ThemedLabel Grid.Row="1" Grid.Column="0" Content="Email"/>
            <cc:ThemedTextBox Grid.Row="1" Grid.Column="1" x:Name="txtEmail"/>
            <cc:ThemedLabel Grid.Row="2" Grid.Column="0" Content="Phone"/>
            <cc:ThemedTextBox Grid.Row="2" Grid.Column="1" x:Name="txtPhone"/>
            <cc:ThemedLabel Grid.Row="3" Grid.Column="0" Content="Username"/>
            <cc:ThemedTextBox Grid.Row="3" Grid.Column="1" x:Name="txtUsername"/>
            <cc:ThemedLabel Grid.Row="4" Grid.Column="0" Content="Password"/>
            <cc:ThemedTextBox Grid.Row="4" Grid.Column="1" x:Name="txtPassword"/>
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <cc:ThemedButton x:Name="btnRegister" Width="120" Content="Register" Click="btnRegister_Click"/>
        </StackPanel>
    </Grid>
</Window>
